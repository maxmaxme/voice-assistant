{
  "name": "voice-assistant",
  "version": "0.1.0",
  "description": "Voice assistant for smart home control via Home Assistant MCP",
  "author": "Maxim Lepekha <lepekha11@gmail.com>",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:call": "node src/cli/mcp-call.ts",
    "users": "node src/cli/users.ts",
    "realtime:smoke": "node src/cli/realtimeSmoke.ts",
    "http": "AGENT_MODE=http node src/cli/unified.ts",
    "telegram": "AGENT_MODE=telegram node src/cli/unified.ts",
    "start": "node src/cli/unified.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.43.0",
    "h3": "^2.0.1-rc.22",
    "openai": "^6.39.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "telegramify-markdown": "^1.3.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
