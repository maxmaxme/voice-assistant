# Home Assistant AND OpenAI are NO LONGER configured here — install them from
# the web config panel (Integrations). The agent reads url/token/key/model and
# the realtime toggle from the DB at startup.
#   • OpenAI is mandatory: the bot won't start until it's installed & enabled.
#   • HA is optional: if absent, HA MCP tools are simply disabled.
#   • Realtime (Voice PE) starts only when the web panel's Realtime page enable
#     toggle is on. Speakers authenticate with per-device tokens registered as
#     `voice` identities (Users page) — there is no env device token.

# Memory
MEMORY_DB_PATH=data/assistant.db

# Server timezone — used when the agent calls `schedule_action(goal,
# schedule_kind, schedule_expr)` with a wall-clock once-time or a cron
# expression, and when displaying times back to the user. Set this to
# YOUR local timezone (IANA name) so scheduled actions fire and display correctly.
# Examples: Europe/Madrid, Europe/Moscow, America/Los_Angeles.
# REQUIRED — the process fails to start without it (no silent UTC fallback).
TZ=Europe/Madrid

# HTTP auth is DB-backed (no env): mint a token with `npm run users -- mint-http`
# or add an HTTP device on the Users page. Each request sends
# `Authorization: Bearer <token>`; the token's sha256 hash must match an `http`
# identity. `HTTP_API_KEYS` is no longer used.

# HTTP Server Port (optional). Default: 3000.
# HTTP_SERVER_PORT=3000

# Telegram is configured on the Telegram integration in the web panel, not here.
# The bot token lives in the DB; install & enable the integration to start the
# telegram runner. Recipients are resolved from DB-backed identities (the chat a
# message goes to = the target user's linked Telegram chat), so there is no fixed
# outbound chat id either — bind chats with `npm run users -- attach-telegram`.

# OpenAI model, reasoning effort and web_search are configured on the OpenAI
# integration in the web panel, not here.

# Realtime (Voice PE): the enable toggle and per-device tokens are in the DB
# (HA Voice page + Users page), not env. Only the listen port is env.
# REALTIME_PORT=3001

# Channels are not selected by env any more — each self-gates from the web panel:
# Telegram by its integration, HTTP by the HTTP API page toggle, Realtime by the
# HA Voice page toggle. (AGENT_MODE is gone.)
